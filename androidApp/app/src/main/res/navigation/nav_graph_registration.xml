<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_registration"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/NameFragment">

    <fragment
        android:id="@+id/NameFragment"
        android:name="com.example.androidapp.ui.registration.NameFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_name" />
    <fragment
        android:id="@+id/dateAndGenderFragment"
        android:name="com.example.androidapp.ui.registration.DateAndGenderFragment"
        android:label="Date and Gender"
        tools:layout="@layout/fragment_date_and_gender" />
    <!-- פעולה שמנווטת מהפרגמנט של השם לפרגמנט של תאריך ומגדר -->
    <action
        android:id="@+id/action_nameFragment_to_dateAndGenderFragment"
        app:destination="@id/dateAndGenderFragment" />


</navigation>
