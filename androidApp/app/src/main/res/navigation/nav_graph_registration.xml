<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_registration"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/NameFragment">

    <fragment
        android:id="@+id/NameFragment"
        android:name="com.example.androidapp.ui.registration.NameFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_name" >
        <action
            android:id="@+id/action_nameFragment_to_dateAndGenderFragment"
            app:destination="@id/dateAndGenderFragment" />
    </fragment>

    <fragment
        android:id="@+id/dateAndGenderFragment"
        android:name="com.example.androidapp.ui.registration.DateAndGenderFragment"
        android:label="Date and Gender"
        tools:layout="@layout/fragment_date_and_gender" >
        <action
            android:id="@+id/action_dateAndGenderFragment_to_usernameFragment"
            app:destination="@id/usernameFragment" />
    </fragment>

    <fragment
        android:id="@+id/usernameFragment"
        android:name="com.example.androidapp.ui.registration.UsernameFragment"
        android:label="Username"
        tools:layout="@layout/fragment_username" >
        <action
            android:id="@+id/action_usernameFragment_to_passwordFragment"
            app:destination="@id/passwordFragment" />
    </fragment>

    <fragment
        android:id="@+id/passwordFragment"
        android:name="com.example.androidapp.ui.registration.PasswordFragment"
        android:label="Password"
        tools:layout="@layout/fragment_password" >
        <action
            android:id="@+id/action_passwordFragment_to_profilePictureFragment"
            app:destination="@id/profilePictureFragment" />
    </fragment>

    <fragment
        android:id="@+id/profilePictureFragment"
        android:name="com.example.androidapp.ui.registration.ProfilePictureFragment"
        android:label="Profile Picture"
        tools:layout="@layout/fragment_profile_picture" >
        <action
            android:id="@+id/action_profilePictureFragment_to_summaryFragment"
            app:destination="@id/summaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/summaryFragment"
        android:name="com.example.androidapp.ui.registration.SummaryFragment"
        android:label="SummaryFragment"
        tools:layout="@layout/fragment_summary" >

        <!-- Navigate back to NameFragment when restarting registration -->
        <action
            android:id="@+id/action_summaryFragment_to_nameFragment"
            app:destination="@id/NameFragment" />

        <!-- Navigate forward to LoginFragment upon confirmation -->
        <!--<action
            android:id="@+id/action_summaryFragment_to_loginFragment"
            app:destination="@id/loginFragment" />-->
    </fragment>
</navigation>
