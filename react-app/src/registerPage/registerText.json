{
  "confirm": {
    "title": "Review your account info",
    "text": "You can use this email address to sign in later",
    "fildes": ["displayName", "userName", "preview"],
    "button": {
      "nextBtn": "Confirm",
      "changeBtnText": "Restart"
    }
  },
  "0": {
    "title": "Create a SayHi Account",
    "text": "Enter your name",
    "inputs": [
      {
        "index": 0,
        "id": "register-name1",
        "type": "text",
        "name": "firstWord",
        "className": "display-name input-full-row",
        "placeHolder": "First name"
      },
      {
        "index": 1,
        "id": "register-name2",
        "type": "text",
        "name": "secondWord",
        "className": "display-name input-full-row",
        "placeHolder": "Last name (optional)"
      }
    ],
    "button": {
      "nextBtn": "Next"
    }
  },
  "1": {
    "title": "Basic information",
    "text": "Enter your birthday and gender",
    "errorText": [
      {
        "404": "Please enter a valid date",
        "400": [
          "Please fill in a complete birthday",
          "Please select your gender"
        ]
      }
    ],
    "birthDay": [
      {
        "index": 0,
        "placeHolder": "Day",
        "className": "date-param",
        "id": "day-form",
        "name": "day",
        "type": "text",
        "min": 1,
        "max": 31
      },
      {
        "index": 1,
        "placeHolder": "Month",
        "className": "form-select date-param",
        "id": "month-form",
        "name": "month",
        "type": "select",
        "options": [
          "January",
          "February",
          "March",
          "April",
          "May",
          "June",
          "July",
          "August",
          "September",
          "October",
          "November",
          "December"
        ]
      },
      {
        "index": 2,
        "placeHolder": "Year",
        "className": "date-param",
        "id": "year-form",
        "name": "year",
        "type": "text"
      }
    ],
    "select": {
      "placeHolder": "Gender",
      "name": "gender",
      "id": "gender-select",
      "className": "form-select",
      "type": "select",
      "options": ["Male", "Female", "Other"]
    },

    "button": {
      "nextBtn": "Next",
      "changeBtnText": "Back"
    }
  },
  "2": {
    "title": "How you will sign in",
    "text": "Create a SayHi address for signing in to your SayHi Account",
    "inputs": [
      {
        "index": "0",
        "id": "username",
        "name": "username",
        "type": "text",
        "className": "username",
        "placeHolder": "Username",
        "explainText": "You can use letters, numbers & periods",
        "waterMark": "@sayhi.com"
      }
    ],
    "errorText": [
      {
        "404": [
          "Use 8 characters or more for your password",
          "Those passwords did not match. Try again."
        ]
      }
    ],
    "button": {
      "nextBtn": "Next",
      "changeBtnText": "Back"
    }
  },
  "3": {
    "title": "Create a strong password",
    "text": "Create a strong password with a mix of letters, numbers and symbols",

    "inputs": [
      {
        "index": "0",
        "id": "reg-password",
        "name": "password",
        "className": "password input-full-row",
        "placeHolder": "Password"
      },
      {
        "index": "1",
        "id": "reg-confirm",
        "name": "confirm",
        "className": "password input-full-row",
        "placeHolder": "Confirm"
      }
    ],
    "showPass": {
      "id": "password-btn",
      "type": "checkbox",
      "name": "toggel",
      "label": "Show password"
    },
    "errorText": [
      { "404": "Wrong password. Please try again.", "400": "Enter a password" }
    ],
    "button": {
      "nextBtn": "Next",
      "changeBtnText": "Back"
    }
  },
  "4": {
    "title": "Personalize your account!",
    "text": "Choose your profile picture \n (Supported formats: JPEG, PNG, WEBP, SVG).",
    "image": {
      "id": "form-picture",
      "className": "hide-filde",
      "type": "file",
      "name": "pic",
      "alt": "preview",
      "fileType": "image/*",
      "placeHolder": "choose pic"
    },
    "button": {
      "nextBtn": "Next",
      "changeBtnText": "Back"
    }
  }
}
