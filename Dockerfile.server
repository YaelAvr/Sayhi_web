FROM gcc:latest

ARG BUILD_TESTING=OFF
RUN apt-get update && apt-get install -y cmake

# WORKDIR /usr/gmail-project/servers/cpp
# COPY . .

WORKDIR /usr/gmail-project


# Copy only the files essential for the C++ build. 
COPY CMakeLists.txt .

# Copy the source code directories.
# By copying only these specific folders, we avoid invalidating the cache when
# unrelated files change.
COPY servers/src/cpp/ ./servers/src/cpp/
COPY Tests/ ./Tests/

RUN mkdir -p /usr/gmail-project && ln -s /usr/gmail-project/servers/data /data

RUN mkdir build && \
    cd build && \
    cmake -DBUILD_TESTING=${BUILD_TESTING} .. && make -j$(nproc)

# RUN mkdir -p build && ln -s /app/servers/data /data
# WORKDIR /usr/gmail-project/build

CMD ["./build/my_program", "8080", "30", "2", "1"]


# # Run cmake and make. 
# # The -DBUILD_TESTING=${BUILD_TESTING} command passes the argument into your CMake configuration. 
# # This is the "switch" that turns testing on or off.
# # The 'make -j' command tries to build in parallel, speeding up compilation.
# RUN cmake -DBUILD_TESTING=${BUILD_TESTING} .. && make -j$(nproc)

