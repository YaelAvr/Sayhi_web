<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.androidapp.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_nav_home_to_editNewMailFragment"
            app:destination="@id/editNewMailFragment"
            app:enterAnim="@null"
            app:exitAnim="@null"
            app:popEnterAnim="@null"
            app:popExitAnim="@null" />
    </fragment>

    <fragment
        android:id="@+id/nav_gallery"
        android:name="com.example.androidapp.ui.gallery.GalleryFragment"
        android:label="@string/menu_gallery"
        tools:layout="@layout/fragment_gallery" />

    <fragment
        android:id="@+id/nav_slideshow"
        android:name="com.example.androidapp.ui.slideshow.SlideshowFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_slideshow" />
    <fragment
        android:id="@+id/editNewMailFragment"
        android:name="com.example.androidapp.ui.editmail.EditNewMailFragment"
        android:label="EditNewMailFragment" />
    <fragment
        android:id="@+id/singleMailFragment"
        android:name="com.example.androidapp.ui.home.SingleMailFragment"
        android:label="Single Mail"
        tools:layout="@layout/fragment_single_mail">

        <argument
            android:name="mailId"
            app:argType="string" />
    </fragment>
</navigation>