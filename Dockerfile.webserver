FROM node:20-slim

WORKDIR /usr/src/gmail-project

COPY package*.json ./
COPY react-app/package*.json ./react-app/
COPY servers/package*.json ./servers/

RUN npm install

COPY servers/src/web/ ./
COPY servers/data ./
COPY react-app ./

EXPOSE 5000

# build react + run react & express
CMD ["npm", "run", "deploy"]

