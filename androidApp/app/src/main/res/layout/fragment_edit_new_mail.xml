<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".ui.editmail.EditNewMailFragment">

    <!--  הוספנו את ה-Toolbar הזה  -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_edit_mail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_close"/>

    <!-- קו הפרדה ויזואלי -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- שאר הקוד שלך נשאר כמעט זהה -->
    <EditText
        android:id="@+id/mail_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/to"
        android:inputType="textEmailAddress"
        android:padding="15dp"
        android:background="@android:color/transparent"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <EditText
        android:id="@+id/mail_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/subject"
        android:inputType="text"
        android:padding="15dp"
        android:background="@android:color/transparent"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <EditText
        android:id="@+id/mail_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="@string/compose_email"
        android:inputType="textMultiLine"
        android:padding="15dp"
        android:background="@android:color/transparent"
        android:textSize="18sp" />

    <!-- כפתור "שלח" בתחתית המסך - מתוקן -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/send"
        android:textSize="16sp" />

</LinearLayout>
